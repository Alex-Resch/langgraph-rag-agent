GEMINI_API_KEY="your_gemini_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"
# Optional - tracing is disabled without these
LANGFUSE_PUBLIC_KEY="your_langfuse_public_key_here"
LANGFUSE_SECRET_KEY="your_langfuse_secret_key_here"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# Optional - answer only from documents and forward unanswered questions
# DOCS_ONLY="true"
# HANDOFF_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# HANDOFF_EMAIL_TO="support@example.com"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="bot@example.com"
# SMTP_PASSWORD="your_smtp_password_here"
# Optional - require a login (create the secret with: uv run chainlit create-secret)
# CHAT_PASSWORD="choose_a_password"
# CHAT_USERNAME="team"
# CHAINLIT_AUTH_SECRET="your_chainlit_auth_secret_here"
